# Miglore OS Backend 环境变量模板
# 复制为 .env 并填入真实值（.env 不入库）

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=0

# MySQL (开发库 miglore_os，与生产 miglore 完全隔离)
DATABASE_NAME=miglore_os
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=miglore_os
DATABASE_PASSWORD=change_me

# CORS 允许来源（开发）
CORS_ORIGINS=http://127.0.0.1:5173
